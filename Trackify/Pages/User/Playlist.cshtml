@page "{id:int}"
@using Trackify.Domain.Models;
@model Trackify.Pages.User.PlaylistModel
@{
    Playlists playlist = Model.Playlist;
    Users user = Model.playlistUser;
}

    <!-- album pic and info + songs -->
    <div class="col-9 flex-grow-1 p-0">
        <div class="card h-100 p-5" style="max-height: 696px; background: linear-gradient(to bottom, @playlist.PlaylistsColor 0%, #121212 25%);">
            <div class="row p-0 m-0" style="height: 200px;">
                <div class=" p-0 me-5" style="height: 200px; width: 200px;">
                    <img src="@playlist.PlaylistImage" style="height: 200px; width: 200px;" />
                </div>
                <div class="col-8 p-0">
                    <br />
                    <span class="small">@Model.PrivacyStatus Playlist</span>
                    <br />
                    <div class="row">
                    <div class="p-0" style="text-overflow: ellipsis; white-space: nowrap; overflow: hidden;">
                            <h1 class="fw-bold" style="font-size: 6em; max-width: fit-content;">@playlist.PlaylistName</h1>
                        </div>
                        

                    </div>
                    <div class="row p-0 d-flex" style="height: 30px;">

                        <a class="d-flex text-reset pe-1" id="clickable-link" asp-page="/User/Profile" asp-route-Id="@playlist.UserId" style="max-width:fit-content">
                            <img src="@user.pfp" style="height: 30px; width: 30px;" class="roundbutton" />
                        <p class="m-0 align-content-center" style="text-overflow: ellipsis; white-space: nowrap; overflow: hidden;">
                                <span class="ms-1 fw-bold ">@user.nickname</span>
                            </p>
                        </a>
                        <div class="d-flex align-content-center p-0" style="width: fit-content;">
                            <span class="align-content-center small"> • @playlist.Songs.Count() songs,</span>
                        </div>
                        <div class=" align-content-center p-0" style="width: fit-content;">
                            <span class="align-content-center small"> @Model.totalTime</span>
                        </div>
                    @{
                        if (playlist.UserId == HttpContext.Session.GetInt32("Id"))
                        {
                            <span class="align-content-center" style="max-width: fit-content;">
                                <span style="max-width: fit-content; max-height: fit-content;" type="button" data-bs-toggle="modal" data-bs-target="#EditPlaylistModal"><svg bootstrap-icon="Pencil" height="25px" width="25px"></svg></span>
                                <span style="max-width: fit-content; max-height: fit-content;" type="button" data-bs-toggle="modal" data-bs-target="#UploadSongModal"><svg bootstrap-icon="PlusLg" height="25px" width="25px"></svg></span>
                                <span style="max-width: fit-content; max-height: fit-content;" type="button" data-bs-toggle="modal" data-bs-target="#ConfirmDeletionModal"><svg bootstrap-icon="Trash" height="25px" width="25px"></svg></span>
                            </span>
                        }
                    }
                    </div>
                </div>
            </div>
            <!--songs-->
            <div class="mt-2 border-top p-0 overflow-auto" style="height: 400px;">
                @{ 
                    foreach(Songs song in playlist.Songs)
                    {
                        <div class="border-bottom m-0 d-flex align-items-center">
                            <form method="post" asp-page-handler="SongPress">
                                <div class="d-flex justify-content-start btn">
                                    <input type="number" asp-for="Song" hidden value="@song.songId" />
                                <label>
                                    <svg class="align-middle" bootstrap-icon="Play" height="20px" width="20px"></svg>
                                    <input hidden type="submit" value=""/>
                                </label>
                                </div>

                            </form>
                            <div class="col-8 ps-1 me-5" style="">@song.title</div>
                            <div class="col-2 opacity-50" style="">@song.timesPlayed</div>
                            <div class="col-1 d-flex justify-content-end pe-2 align-items-center" style="">
                                @song.length.Minutes:@if (song.length.Seconds < 10)
                                {<span>0</span>}@song.length.Seconds
                                

                                <div class="btn-group">
                                    <div class=" d-flex justify-content-end btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <svg bootstrap-icon="ThreeDots" height="20px" width="20px"></svg>
                                    </div>
                                    <ul class="dropdown-menu dropdown-menu-end dd" style="background-color: #282828;">
                                        <li>
                                            <form method="post" asp-page-handler="AddToQueue">
                                                <input type="number" asp-for="Song" hidden value="@song.songId" />
                                                <button type="submit" class="dditem btn w-100 text-start">Add To Queue</button>
                                            </form>
                                        </li>
                                    <li>
                                        <form method="post" asp-page-handler="RemoveFromPlaylist">
                                            <input type="number" asp-for="Song" hidden value="@song.playlistSongId" />
                                            <button type="submit" class="dditem btn w-100 text-start">Remove from this playlist</button>
                                        </form>
                                    </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

<!-- Modal for editing Playlist -->
<div class="modal fade" id="EditPlaylistModal" tabindex="-1" aria-labelledby="EditPlaylistModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="EditPlaylistModalLabel">Playlist details</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form method="post" enctype="multipart/form-data" asp-page-handler="EditPlaylist">
                    <div class="row">
                        <div class="col-7">
                            <input type="file" asp-for="NewCover" />
                        </div>
                        <div class="col-2 ms-3">
                            <input type="color" value="@playlist.PlaylistsColor" asp-for="NewColor" />
                        </div>
                    </div>
                    <div class="pt-5">
                        <input maxlength="255" class="form-control" placeholder="@playlist.PlaylistName" asp-for="NewTitle" />
                    </div> <br />
                    <label>current: @Model.PrivacyStatus</label> <br />
                    <select asp-for="NewPrivacy">
                        <option selected>change privacy</option>
                        <option value="true">Private</option>
                        <option value="false">Public</option>
                    </select>
                    <div class="form-control invisible"> </div><br />
                    <div class="d-flex justify-content-end mb-3">
                        <input type="submit" class="btn btn-success border-success col-3" data-bs-dismiss="modal" value="Confirm" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!--Confirm deletion of playlist modal-->
<div class="modal fade" id="ConfirmDeletionModal" tabindex="-1" aria-labelledby="ConfirmDeletionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="ConfirmDeletionModalLabel">Are you sure you want to delete this playlist</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <form method="post" enctype="multipart/form-data" asp-page-handler="DeletePlaylist">
                    <div class="row">

                    <div class="form-control invisible"> </div><br />
                    <div class="d-flex justify-content-around mb-3">
                        <input type="button" class="btn btn-danger col-3" data-bs-dismiss="modal" value="Cancel" />
                            <div class="form-control invisible"> </div>
                        <input type="submit" class="btn btn-success border-success col-3" data-bs-dismiss="modal" value="Confirm" />
                    </div>
                </form>

            </div>


        </div>
    </div>
</div>
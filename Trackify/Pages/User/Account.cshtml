@page
@using Trackify.Domain.Models
@model Trackify.Pages.User.AccountModel
@{
}
<div class="d-flex justify-content-center">
    <div class="col-5 row row-gap-4">
        <div class="p-0">
            <a class="text-decoration-none text-reset" href="https://localhost:7082/User/Subscription">
                <div class="card account btn p-0 form-control pb-3" href="/User/Subscription">
                    <div class="row m-0 row-gap-3">
                        <div class="card-header-pills account small fw-bold card col-2 m-0 p-0" style=" background-color: #404040;">Your current subscription</div>
                        <div class="text-start row m-0 p-0 row-gap-2">
                            <span class="text-white small fw-bold"><img src="~/ImagesAndSongs/Logo/Transparent white.png" style="height: 24px; width: 24px;" /> Premium</span>
                            <br />
                            <span class="h2 fw-bold">Premium</span>
                            <div class="p-0 m-0 row">
                                <span>you have a x subcription plan</span>

                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>
        <div class="card account pt-1"> <!--try just margin/padding end on the first one-->
            <div class="row">
                <div class="me-5 col-6">
                    <span class="fw-bold h3">Apply to become artist</span>
                    <div class="form-control invisible"> </div>
                    <form method="post" asp-page-handler="Application">
                        <input type="submit" class="btn w-50" style="background-color: #404040;" value="Press to apply">
                    </form>
                </div>
                @{
                    if (Model.application != null)
                    {
                        <div class="col-6">
                            <span class="fw-bold h5">Current application</span>
                        </div>
                    }
                    else
                    {

                    }
                }
            </div>
        </div>

    </div>
</div>
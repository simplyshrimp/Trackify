@page
@using Trackify.Domain.Models;
@model Trackify.Pages.User.EditInfoModel
@{
    Users user = Model.user;
}

@{
    <div class=" d-flex justify-content-center">
        <div class="col-9 border">
            <form method="post">
                <label>Username: </label>
                <input type="text" placeholder="@user.username" /> <br>

                <label>First name: </label>
                <input placeholder="@user.firstName" /> <br>
                <label>Last name</label>
                <input placeholder="@user.lastName" /> <br>
                <label>Email: </label>
                <input type="email" placeholder="@user.email" /> <br>

            </form>
        </div>
    </div>
}
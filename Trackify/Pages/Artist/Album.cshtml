@page "{id:int}"
@using Trackify.Domain.Models;
@model Trackify.Pages.Artist.AlbumModel
@{
    Albums album = Model.album;

}

    <!-- album pic and info + songs -->
<div class="col-9 flex-grow-1 p-0 h-100">
    <div class="card h-100 p-5" style="max-height: 696px; background: linear-gradient(to bottom, @album.color 0%, #121212 25%);">
            <div class="row p-0 m-0" style="height: 200px;">
                <div class=" p-0 me-5" style="height: 200px; width: 200px;">
                    <img src="@album.albumImage" style="height: 200px; width: 200px;" />
                </div>
                <div class="col-8 p-0">
                    <br />
                    <span class="small">@Model.PrivacyStatus @album.albumType</span>
                    <br />
                    <div class="row">
                    <div class="p-0" style="text-overflow: ellipsis; white-space: nowrap; overflow: hidden;">
                            <h1 class="fw-bold" style="font-size: 6em; max-width: fit-content;">@album.albumTitle</h1>
                        </div>
                        

                    </div>
                    <div class="row p-0 d-flex" style="height: 30px;">

                        <a class="d-flex text-reset pe-1" id="clickable-link" asp-page="/Artist/ArtistPage" asp-route-ArtistId="@album.artist.artistID" style="max-width:fit-content">
                            <img src="@album.artist.user.pfp" style="height: 30px; width: 30px;" class="roundbutton" />
                        <p class="m-0 align-content-center" style="text-overflow: ellipsis; white-space: nowrap; overflow: hidden;">
                                <span class="ms-1 fw-bold ">@album.artist.user.nickname</span>
                            </p>
                        </a>
                        <div class="d-flex align-content-center p-0" style="width: fit-content;">
                            <span class="align-content-center small"> • @album.songs.Count() songs,</span>
                        </div>
                        <div class=" align-content-center p-0" style="width: fit-content;">
                            <span class="align-content-center small"> @Model.totalTime</span>
                        </div>
                    @{
                        if (album.artist.artistID == HttpContext.Session.GetInt32("ArtistID"))
                        {
                            <span class="align-content-center" style="max-width: fit-content;">
                                <span style="max-width: fit-content; max-height: fit-content;" type="button" data-bs-toggle="modal" data-bs-target="#EditAlbumModal"><svg bootstrap-icon="Pencil" height="25px" width="25px"></svg></span>
                                <span style="max-width: fit-content; max-height: fit-content;" type="button" data-bs-toggle="modal" data-bs-target="#UploadSongModal"><svg bootstrap-icon="PlusLg" height="25px" width="25px"></svg></span>
                            </span>
                        }
                    }
                    </div>
                </div>
            </div>
            <!--songs-->
            <div class="mt-2 border-top p-0 overflow-auto" style="height: 400px;">
                @{ 
                    foreach(Songs song in album.songs)
                    {
                        <div class="border-bottom m-0 d-flex align-items-center">
                            <form method="post" asp-page-handler="SongPress">
                                <div class="d-flex justify-content-start btn">
                                    <input type="number" asp-for="Song" hidden value="@song.songId" />
                                <label>
                                    <svg class="align-middle" bootstrap-icon="Play" height="20px" width="20px"></svg>
                                    <input hidden type="submit" value=""/>
                                </label>
                                </div>

                            </form>
                            <div class="col-8 ps-1 me-5" style="">@song.title</div>
                            <div class="col-2 opacity-50" style="">@song.timesPlayed</div>
                            <div class="col-1 d-flex justify-content-end pe-2 align-items-center" style="">
                                @song.length.Minutes:@if (song.length.Seconds < 10)
                                {<span>0</span>}@song.length.Seconds
                                

                                <div class="btn-group">
                                <div class=" d-flex justify-content-end btn" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                        <svg bootstrap-icon="ThreeDots" height="20px" width="20px"></svg>
                                    </div>
                                    <ul class="dropdown-menu dropdown-menu-end dd" style="background-color: #282828;">
                                        <li>
                                            <form method="post" asp-page-handler="AddToQueue">
                                                <input type="number" asp-for="Song" hidden value="@song.songId" />
                                                <button type="submit" class="dditem btn w-100 text-start">Add To Queue</button>
                                            </form>
                                        </li>
                                        @{ if (HttpContext.Session.GetInt32("LoggedIn") == 1)
                                        {
                                            <li class="dropup">
                                                <div class="btn-group">
                                                    <div class=" btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">Add to playlist</div>
                                                    <ul class="dropdown-menu dropdown-menu-end dd overflow-y-auto" style="height: 10rem; background-color: #282828;">
                                                        @{
                                                            Model.GetUserPlaylists();
                                                            List<Playlists> userPlaylists = Model.allUsersPlaylists;
                                                            if (userPlaylists.Count > 0)
                                                            {
                                                                foreach (Playlists playlist in userPlaylists)
                                                                {
                                                                <li>
                                                                <form method="post" asp-page-handler="AddSongToPlaylist">
                                                                    <input type="number" asp-for="Song" hidden value="@song.songId" />
                                                                    <input type="number" asp-for="PlaylistId" hidden value="@playlist.PlaylistId" />
                                                                    <button type="submit" class="dditem btn w-100 text-start">@playlist.PlaylistName</button>
                                                                </form>
                                                                </li>
                                                                }
                                                                
                                                            }
                                                            else
                                                            {
                                                                <li>
                                                                    <form method="post" asp-page-asp-page-handler="CreatePlaylist">
                                                                        <input type="number" asp-for="Song" hidden value="@song.songId" />
                                                                        <button type="submit" class="dditem btn w-100 text-start">Create new Playlist</button>
                                                                    </form>
                                                                </li>
                                                            }
                                                        }
                                                    </ul>
                                                </div>
                                            </li>
                                        }}
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }
                }

            </div>
        </div>
    </div>

<!-- Modal for editing album -->
<div class="modal fade" id="EditAlbumModal" tabindex="-1" aria-labelledby="EditAlbumModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="EditAlbumModalLabel">Album details</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <form method="post" enctype="multipart/form-data" asp-page-handler="EditAlbum">
                    <div class="row">
                        <div class="col-7">
                            <input type="file" asp-for="NewCover" accept=".jpeg, .jpg, .png" />
                        </div>
                        <div class="col-2 ms-3">
                            <input type="color" value="@album.color" asp-for="NewColor" />
                        </div>
                    </div>
                    <div class="pt-5">
                        <input maxlength="255" class="form-control" placeholder="@album.albumTitle" asp-for="NewTitle" />
                    </div> <br />
                    <label>current: @Model.PrivacyStatus</label> <br />
                    <select asp-for="NewPrivacy">
                        <option selected>change privacy</option>
                        <option value="true">Private</option>
                        <option value="false">Public</option>
                    </select>
                    <div class="form-control invisible"> </div><br />
                    <div class="d-flex justify-content-end mb-3">

                        <input type="submit" class="btn btn-success border-success col-3" data-bs-dismiss="modal" value="Confirm" />
                    </div>
                </form>

            </div>


        </div>
    </div>
</div>

<!-- Modal for uploading songs -->
<div class="modal fade" id="UploadSongModal" tabindex="-1" aria-labelledby="UploadSongsModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="UploadSongModalLabel">Upload Song</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <form method="post" enctype="multipart/form-data" asp-page-handler="UploadSong">
                    <div class="row">
                        <div class="col-7">
                            <input type="file" asp-for="NewSong" accept=".mp3" />
                        </div>
                    </div>
                    <div class="pt-5">
                        <select asp-for="genre">
                            <option selected>Select a genre</option>
                            @foreach (Genres genre in Model.allGenres)
                            {
                                <option value="@genre.GenreId">@genre.GenreName</option>
                            }
                        </select>
                    </div>
                    <div class="form-control invisible"> </div><br />
                    <div class="d-flex justify-content-end mb-3">

                        <input type="submit" class="btn btn-success border-success col-3" data-bs-dismiss="modal" value="Confirm" />
                    </div>
                </form>

            </div>


        </div>
    </div>
</div>
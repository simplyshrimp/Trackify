@page "{id:int}"
@using Trackify.Domain.Models;
@model Trackify.Pages.Artist.AlbumModel
@{
    Albums album = Model.album;
    Artists artist = Model.artist;
    string albumPrivacyStatus = "";
    if (album.madePrivate)
        albumPrivacyStatus = "private";
    else
        albumPrivacyStatus = "public";

}

<div class="row h-100 gap-2">
    <!-- sidebar with playlists -->
    <div class="col-2 p-0">
        <div class="card h-100"></div>
    </div>
    <!-- album pic and info + songs -->
    <div class="col-9 flex-grow-1 p-0">
        <div class="card h-100 p-5" style="background: linear-gradient(to bottom, @album.color 0%, #121212 25%);">
            <div class="row p-0 m-0">
                <div class=" p-0 me-5" style="height: 200px; width: 200px;">
                    <img src="@album.albumImage" style="height: 200px; width: 200px;" />
                </div>
                <div class="col-6 p-0">
                    <br />
                    <span class="small">@albumPrivacyStatus @album.albumType</span>
                    <br />
                    <h1 class="fw-bold" style="font-size: 6em;">@album.albumTitle</h1>
                    <div class="row p-0">
                        <div style="max-width: 150px;">
                            <a class="text-reset" id="clickable-link" asp-page="/Artist/ArtistPage" asp-route-ArtistId="@album.artist.artistID" style="width: 100px;">
                                <div class="row" >
                                    <div style="height: 30px; width: 30px;" class="me-3">
                                        <img src="@album.artist.user.pfp" style="height: 30px; width: 30px;" class="roundbutton" />
                                    </div>
                                    <div class="p-0 align-content-center" style="min-width: 20px; max-width: 100px;">
                                        <span style="min-width: 20px; max-width: 100px;"class="fw-bold">@album.artist.user.nickname</span>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div class="align-content-center p-0" style="width: 100px;">
                            <span class="small"> • @album.songs.Count() songs,</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@page
@model Trackify.Pages.SignupModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Trackify</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/stylesheet.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Trackify.styles.css" asp-append-version="true" />
</head>
<body class="gradientUp">
    <div>
        <header>
            <div class=" d-flex justify-content-center pt-5 mt-5" style="height:auto;">
                <div id="LoginPage" class="card text-center pt-3" style="height: 500px; width: 668px;">
                    <div class="row gap-3">
                        <div>
                            <img src="~/ImagesAndSongs/Logo/White with Black.png" style="height: 90px; width: 90px;" />
                            <i class="bi bi-spotify"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold"> Log in to Trackify</h4>
                        </div>
                        <div>
                            <div class="border"></div>
                        </div>
                    </div>
                        <div class="col-12 d-flex justify-content-center">
                            <form method="post" class="form-control">
                                <div class="row gap-2">
                                    <div class="col-6">
                                        <div>
                                            <label class="fw-bold small">Username</label>
                                            <br />
                                            <input class="LoginPage" placeholder="Username" asp-for="Username">
                                            <br />
                                            <span class="text-danger" asp-validation-for="Username"></span>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label class="fw-bold small">Password</label>
                                        <br />
                                        <input type="password" class="LoginPage" placeholder="Password" asp-for="Password">
                                        <br />
                                        <span class="text-danger" asp-validation-for="Password"></span>
                                        <br />
                                        <br />
                                    </div>
                                    <div>
                                        <a class="btn border rounded-5" href="">Continue</a>
                                    </div>
                                </div>
                            </form>
                        </div>
                        <div class="mt-3">
                            <p> Don't have an account? <a class="text-decoration-underline text-white">Sign up for Trackify</a></p>
                        </div>
                </div>
            </div>
        </header>
        <footer class="Login border-top-0 footer text-muted small align-content-center" style="height:81px;">
            <div class="container d-flex justify-content-center">
                &copy; 2025 - Trackify - <a class="Login" asp-area="" asp-page="/Privacy">Privacy</a>
            </div>
        </footer>
    </div>
</body>
</html>

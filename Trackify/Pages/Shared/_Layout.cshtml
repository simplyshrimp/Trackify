<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <base href="~/" />
    <component type="typeof(Microsoft.AspNetCore.Components.Web.HeadOutlet)"
               render-mode="ServerPrerendered" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Trackify</title>
    <link rel="icon" type="image/x-icon" href="/ImagesAndSongs/favicon2.ico">
    <script src="_framework/blazor.server.js"></script>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/stylesheet.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Trackify.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom-0 box-shadow mb-1" style="height: 64px;">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-page="/Index"><img class="ms-2" style="height: 38px; width: 38px;" src="~/ImagesAndSongs/Logo/Transparent white.png" /></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                    </ul>
                    <ul class="navbar-nav flex-grow-1 d-flex justify-content-center">
                        <li>
                            @if (Context.Session.GetInt32("LoggedIn") == 1)
                            {
                                <a asp-page="/HomePage">
                                    <button class="roundbutton me-2">
                                        <svg bootstrap-icon="HouseDoorFill" height="24px" width="24px"></svg>
                                    </button>
                                </a>
                            }
                            else
                            {
                                <a asp-page="/Index">
                                    <button class="roundbutton me-2">
                                        <svg bootstrap-icon="HouseDoorFill" height="24px" width="24px"></svg>
                                    </button>
                                </a>
                            }
                        </li>
                        <li>
                            <div class="search-bar">
                                <button class="search-submit" tabindex="0">
                                    <svg bootstrap-icon="Search" height="24px" width="24px"></svg>
                                </button>
                                <input type="search" class="search-input" placeholder="What do you want to play?" style="width: 474px ; height: 48px;" tabindex="0" />
                                <div class="divider"></div>
                                <button class="search-submit">
                                    <svg bootstrap-icon="Folder2Open" height="25px" width="25px"></svg>
                                </button>
                            </div>
                        </li>
                    </ul>
                    @{
                        if (Context.Session.GetInt32("Admin") == 1 && Context.Session.GetInt32("ArtistID") != null)
                        {
                            <ul class="navbar-nav flex-grow-1 d-flex justify-content-end">
                                <li class="nav-item">
                                    <a class="nav-link fw-bold mt-2" asp-area="" asp-page="User/Subscribe">Premium</a>
                                </li>
                                <li>
                                    <div class="divider"></div>
                                </li>
                                <li class="pt-1">
                                    <div class="btn-group">
                                        <button class="m-0 ms-1 roundbuttonbig" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <img class="roundbutton" src="@Context.Session.GetString("pfp")" style="width:32px; height: 32px;" />
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end dd" style="background-color: #282828;">
                                            <li>
                                                <a class="dditem" asp-page="/User/Account">
                                                    <button class="dditem btn w-100 text-start">Account</button>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dditem" asp-route-id="@Context.Session.GetInt32("Id")" asp-page="/User/Profile">
                                                    <button class="dditem btn w-100 text-start">Profile</button>
                                                </a>
                                            </li>

                                            <li>
                                                <a class="dditem" asp-page="/User/Settings">
                                                    <button class="dditem btn w-100 text-start">Settings</button>
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider"></li> <!--Artist-->
                                            <li>
                                                <a class="dditem" asp-page="/Artist/AddAlbum">
                                                    <button class="dditem btn w-100 text-start">Add Albums</button>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dditem" asp-page="/Artist/AllArtistAlbums">
                                                    <button class="dditem btn w-100 text-start">See all your albums</button>
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider"></li> <!--Admin-->
                                            <li>
                                                <a class="dditem" asp-page="/Admin/ReviewApplications">
                                                    <button class="dditem btn w-100 text-start">View Artist Applications</button>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dditem" asp-page="/Admin/AdminSupport">
                                                    <button class="dditem btn w-100 text-start">Support</button>
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider"></li> <!--Log out-->
                                            <li>
                                                <a class="dditem" asp-page="/User/LogOut">
                                                    <button class="dditem btn w-100 text-start ">Log out</button>
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </li>
                            </ul>
                        }
                        else if (Context.Session.GetInt32("Admin") == 1)
                        {
                            <ul class="navbar-nav flex-grow-1 d-flex justify-content-end">
                                <li class="nav-item">
                                    <a class="nav-link fw-bold mt-2" asp-area="" asp-page="User/Subscribe">Premium</a>
                                </li>
                                <li>
                                    <div class="divider"></div>
                                </li>
                                <li class="pt-1">
                                    <div class="btn-group">
                                        <button class="m-0 ms-1 roundbuttonbig" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <img class="roundbutton" src="@Context.Session.GetString("pfp")" style="width:32px; height: 32px;" />
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end dd" style="background-color: #282828;">
                                            <li>
                                                <a class="dditem" asp-page="/User/Account">
                                                    <button class="dditem btn w-100 text-start">Account</button>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dditem" asp-route-id="@Context.Session.GetInt32("Id")" asp-page="/User/Profile">
                                                    <button class="dditem btn w-100 text-start">Profile</button>
                                                </a>
                                            </li>

                                            <li>
                                                <a class="dditem" asp-page="/User/Settings">
                                                    <button class="dditem btn w-100 text-start">Settings</button>
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider"></li> <!--Admin-->
                                            <li>
                                                <a class="dditem" asp-page="/Admin/ReviewApplications">
                                                    <button class="dditem btn w-100 text-start">View Artist Applications</button>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dditem" asp-page="/Admin/AdminSupport">
                                                    <button class="dditem btn w-100 text-start">Support</button>
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider"></li> <!--Log out-->
                                            <li>
                                                <a class="dditem" asp-page="/User/LogOut">
                                                    <button class="dditem btn w-100 text-start ">Log out</button>
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </li>
                            </ul>
                        }
                        else if (Context.Session.GetInt32("ArtistID") != null)
                        {
                            <ul class="navbar-nav flex-grow-1 d-flex justify-content-end">
                                <li class="nav-item">
                                    <a class="nav-link fw-bold mt-2" asp-area="" asp-page="User/Subscribe">Premium</a>
                                </li>
                                <li>
                                    <div class="divider"></div>
                                </li>
                                <li class="pt-1">
                                    <div class="btn-group">
                                        <button class="m-0 ms-1 roundbuttonbig" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <img class="roundbutton" src="@Context.Session.GetString("pfp")" style="width:32px; height: 32px;" />
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end dd" style="background-color: #282828;">
                                            <li>
                                                <a class="dditem" asp-page="/User/Account">
                                                    <button class="dditem btn w-100 text-start">Account</button>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dditem" asp-route-id="@Context.Session.GetInt32("Id")" asp-page="/User/Profile">
                                                    <button class="dditem btn w-100 text-start">Profile</button>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dditem" asp-page="/User/Support">
                                                    <button class="dditem btn w-100 text-start">Support</button>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dditem" asp-page="/User/Settings">
                                                    <button class="dditem btn w-100 text-start">Settings</button>
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider"></li> <!--Artist-->
                                            <li>
                                                <a class="dditem" asp-page="/Artist/AddAlbum">
                                                    <button class="dditem btn w-100 text-start">Add Albums</button>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dditem" asp-page="/Artist/AllArtistAlbums">
                                                    <button class="dditem btn w-100 text-start">See all your albums</button>
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider"></li> <!--Log out-->
                                            <li>
                                                <a class="dditem" asp-page="/User/LogOut">
                                                    <button class="dditem btn w-100 text-start ">Log out</button>
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </li>
                            </ul>
                        }
                        else if (Context.Session.GetInt32("LoggedIn") == 1)
                        {
                            <ul class="navbar-nav flex-grow-1 d-flex justify-content-end">
                                <li class="nav-item">
                                    <a class="nav-link fw-bold mt-2" asp-area="" asp-page="User/Subscribe">Premium</a>
                                </li>
                                <li>
                                    <div class="divider"></div>
                                </li>
                                <li class="pt-1">
                                    <div class="btn-group">
                                        <button class="m-0 ms-1 roundbuttonbig" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <img class="roundbutton" src="@Context.Session.GetString("pfp")" style="width:32px; height: 32px;" />
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end dd" style="background-color: #282828;">
                                            <li>
                                                <a class="dditem" asp-page="/User/Account">
                                                    <button class="dditem btn w-100 text-start">Account</button>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dditem" asp-route-id="@Context.Session.GetInt32("Id")" asp-page="/User/Profile">
                                                    <button class="dditem btn w-100 text-start">Profile</button>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dditem" asp-page="/User/Support">
                                                    <button class="dditem btn w-100 text-start">Support</button>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dditem" asp-page="/User/Settings">
                                                    <button class="dditem btn w-100 text-start">Settings</button>
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider"></li> <!--Log out-->
                                            <li>
                                                <a class="dditem" asp-page="/User/LogOut">
                                                    <button class="dditem btn w-100 text-start ">Log out</button>
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </li>
                            </ul>
                        }
                        else
                        {
                            <ul class="navbar-nav flex-grow-1 d-flex justify-content-end">
                                <li class="nav-item">
                                    <a class="nav-link fw-bold mt-2" asp-area="" asp-page="/Subscribe">Premium</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link fw-bold mt-2" asp-area="" asp-page="/Support">Support</a>
                                </li>
                                <li>
                                    <div class="divider"></div>
                                </li>
                                <li class="nav-item small">
                                    <a class="nav-link mt-2 fw-semibold" asp-area="" asp-page="/User/Signup">Sign up</a>
                                </li>
                                <li class="nav-item">
                                    <a class=" btn ms-2 mt-1 pt-1 nav-link fw-semibold form-control bg-white text-black rounded-5 align-content-center" style="width: 108px; height: 48px;" asp-page="/User/Login">Log in</a>
                                </li>
                                <li>
                                    <img src="@Context.Session.GetString("pfp")" />
                                </li>
                            </ul>
                        }
                    }
                </div>
            </div>
        </nav>
        
    </header>
    <div class="container-fluid main-content">
        <main role="main" class="pb-3 h-100">
            <div class="row gap-2 h-100">
                <component type="typeof(Trackify.Pages.Components.PlaylistsSidebar)" render-mode="ServerPrerendered" />
                @RenderBody()
            </div>
        </main>
    </div>

    <footer class="border-top-0 footer text-muted" style="height:81px;">
        <div class="container-fluid h-100">
            <component type="typeof(Trackify.Pages.Components.NowPlaying)" render-mode="ServerPrerendered"/>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

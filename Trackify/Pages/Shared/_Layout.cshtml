<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Trackify</title>
    <link rel="icon" type="image/x-icon" href="/ImagesAndSongs/favicon.ico">
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/stylesheet.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Trackify.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom-0 box-shadow mb-3" style="height: 64px;">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-page="/Index"><img class="ms-2" style="height: 38px; width: 38px;" src="~/ImagesAndSongs/Logo/Transparent white.png" /></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                    </ul>
                    <ul class="navbar-nav flex-grow-1 d-flex justify-content-center">
                        <li>
                                
                        </li>
                        <li>
                            <input class="rounded-5 form-control" placeholder="What do you want to play?" style="width: 474px ; height: 48px;" />
                        </li>
                    </ul>
                    @{
                        if(Context.Session.GetInt32("LoggedIn") == 1)
                        {}
                        else
                        {
                            <ul class="navbar-nav flex-grow-1 d-flex justify-content-end">
                                <li class="nav-item">
                                    <a class="nav-link fw-bold mt-2" asp-area="" asp-page="/Subscribe">Premium</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link fw-bold mt-2" asp-area="" asp-page="/Support">Support</a>
                                </li>
                                    <div class="divider"></div>
                                <li class="nav-item small">
                                    <a class="nav-link mt-2 fw-semibold" asp-area="" asp-page="/Signup">Sign up</a>
                                </li>
                            <li class="nav-item">
                                <a class=" btn ms-2 mt-1 pt-1 nav-link fw-semibold form-control bg-white text-black rounded-5 align-content-center" style="width: 108px; height: 48px;" href="/Login">Login</a>
                                </li>    
                            </ul>
                        }
                    }
                </div>
            </div>
        </nav>
        
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top-0 footer text-muted" style="height:81px;">
        <div class="container">
            &copy; 2025 - Trackify - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

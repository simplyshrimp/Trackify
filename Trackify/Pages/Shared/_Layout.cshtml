<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Trackify</title>
    <link rel="icon" type="image/x-icon" href="/ImagesAndSongs/favicon2.ico">
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/stylesheet.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Trackify.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom-0 box-shadow mb-3" style="height: 64px;">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-page="/Index"><img class="ms-2" style="height: 38px; width: 38px;" src="~/ImagesAndSongs/Logo/Transparent white.png" /></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                    </ul>
                    <ul class="navbar-nav flex-grow-1 d-flex justify-content-center">
                        <li>
                            <button class="roundbutton me-2">
                                <svg bootstrap-icon="HouseDoorFill" height="24px" width="24px"></svg>
                            </button>
                        </li>
                        <li>
                            <div class="search-bar">
                                <button class="search-submit" tabindex="0">
                                    <svg bootstrap-icon="Search" height="24px" width="24px"></svg>
                                </button>
                                <input type="search" class="search-input" placeholder="What do you want to play?" style="width: 474px ; height: 48px;" tabindex="0" />
                                <div class="divider"></div>
                                <button class="search-submit">
                                    <svg bootstrap-icon="Folder2Open" height="25px" width="25px"></svg>
                                </button>
                            </div>
                        </li>
                    </ul>
                    @{
                        if(Context.Session.GetInt32("LoggedIn") == 1)
                        {
                            <ul class="navbar-nav flex-grow-1 d-flex justify-content-end">
                                <li class="nav-item">
                                    <a class="nav-link fw-bold mt-2" asp-area="" asp-page="/Subscribe">Premium</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link fw-bold mt-2" asp-area="" asp-page="/Support">Support</a>
                                </li>
                                <li>
                                    <div class="divider"></div>
                                </li>
                                <li class="nav-item">
                                    <a class=" btn ms-2 mt-1 pt-1 nav-link fw-semibold form-control bg-white text-black rounded-5 align-content-center" style="width: 108px; height: 48px;" href="/Login">Log out</a>
                                </li>
                                <li class="pt-2">
                                    <div class="btn-group">
                                        <button class="m-0 ms-1 roundbuttonbig" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <img class="roundbutton" src="@Context.Session.GetString("pfp")" style="width:32px; height: 32px;" />
                                        </button>
                                        <ul class="dropdown-menu text-start">
                                            <li>
                                                <a href="/Account">Account</a>
                                            </li>
                                            <li>
                                                <a href="/Profile">Profile</a>
                                            </li>
                                            <li>
                                                <a href="/Support">Support</a>
                                            </li>
                                            <li>
                                                <a href="/Settings">Settings</a>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <a href="/LogOut">Log out</a>
                                            </li>
                                        </ul>
                                    </div>
                                </li>
                            </ul>
                        }
                        else
                        {
                            <ul class="navbar-nav flex-grow-1 d-flex justify-content-end">
                                <li class="nav-item">
                                    <a class="nav-link fw-bold mt-2" asp-area="" asp-page="/Subscribe">Premium</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link fw-bold mt-2" asp-area="" asp-page="/Support">Support</a>
                                </li>
                                <li>
                                    <div class="divider"></div>
                                </li>
                                <li class="nav-item small">
                                    <a class="nav-link mt-2 fw-semibold" asp-area="" asp-page="/Signup">Sign up</a>
                                </li>
                                <li class="nav-item">
                                    <a class=" btn ms-2 mt-1 pt-1 nav-link fw-semibold form-control bg-white text-black rounded-5 align-content-center" style="width: 108px; height: 48px;" href="/Login">Log in</a>
                                </li>
                                <li>
                                    <img src="@Context.Session.GetString("pfp")"  />
                                </li>
                            </ul>
                        }
                    }
                </div>
            </div>
        </nav>
        
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!--<footer class="border-top-0 footer text-muted" style="height:81px;">
        <div class="container">
            &copy; 2025 - Trackify - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>-->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

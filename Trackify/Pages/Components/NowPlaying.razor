@using Trackify.Domain.Models
@using Trackify.Service
@using Microsoft.AspNetCore.Http

@code {
    [Inject]
    IHttpContextAccessor HttpContextAccessor { get; set; }
    [Inject]
    IMusic music { get; set; }
    public Songs? currentSong { get; set; }
    public Albums? currentAlbum { get; set; }
    public List<Songs> queue = new();




    public void GetCurrentSong()
    {
        if (HttpContextAccessor.HttpContext.Session.GetString("Queue") != null)
        {
            queue = new();
            var ids = HttpContextAccessor.HttpContext.Session.GetString("Queue").Split(',');
            foreach (string? id in ids)
            {
                queue.Add(music.GetSongByID(Convert.ToInt32(id)));
            }
            currentSong = queue[0];
        }
    }
}
<!-- footer 'playing now' -->

    @{
        GetCurrentSong();
        if (currentSong != null)
        {

                <div class="row m-0 p-0">
                    <div class="ps-2" style="width: fit-content;">
                        <img src="@music.GetAlbumByID(currentSong.albumId).albumImage" style="height:70px; width:70px;" />
                    </div>
                    <div class="ps-2 m-0 d-flex flex-column" style="width: fit-content; height: fit-content;">

                            <span class="ps-2" style="width: fit-content; height: 21px; color: white">@currentSong.title</span>
                            <span class="ps-2" style="width: fit-content; height: 21px; text-decoration-color: white">@music.GetAlbumByID(currentSong.albumId).artist.user.nickname</span>
                    </div>


                    <audio id="audio" controls class="col-8">
                        <source src="@currentSong.filepath" type="audio/mp3" />
                        the browser doesn't support the audio element
                    </audio>
                    <script src="JavaScript/jsmusic.js"></script>
                </div>

        }
    }


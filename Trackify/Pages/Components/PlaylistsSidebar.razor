@code{
    [Inject]
    IHttpContextAccessor HttpContextAccessor { get; set; }
    [Inject]
    IMusic music { get; set; }
    public List<Playlists>? userPlaylists = new();
    public int? id { get; set; }

    public void GetId()
    {
        id = HttpContextAccessor.HttpContext.Session.GetInt32("Id");
    }
    public bool AllPlaylists()
    {
        // userPlaylists =
        if (id != null)
        {
            userPlaylists = music.GetAllUserPlaylists((int)id);
            if (userPlaylists.Count > 0)
                return true;
        }
        return false;
    }
    async Task<int> CreateBlankPlaylist()
    {
        string imagePath = "/ImagesAndSongs/Playlists/Trackify-Album-Placeholder.png";
        int playlistId = music.CreatePlaylist((int)id, "New Playlist", imagePath, "#00000", true);
        userPlaylists.Add(music.GetPlaylistByID(playlistId));
        return playlistId;
    }
    public async Task RedirectToPlaylist(int playlistId)
    {
        string ReturnUrl = "/User/Playlist/" + playlistId.ToString();
        Navigation.NavigateTo(ReturnUrl, true);
        await base.OnInitializedAsync();
    }


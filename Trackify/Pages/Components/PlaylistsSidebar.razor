@using Trackify.Domain.Models
@using Trackify.Service
@using Microsoft.AspNetCore.Http
@using FormData_Class

<head>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<!-- sidebar with playlists -->
@{
    GetId();
}
<div class="col-2">
    <div class="card h-100">
        <div class="d-flex justify-content-between m-0 p-2">
            <h3>Playlists</h3>
            <div class="p-0">
                <button class="h1 fw-bold roundbutton pb-3 pt-2" type="button" data-bs-toggle="modal" data-bs-target="#CreatePlaylistModal">+</button>
            </div>
@{
                AllPlaylists();
                foreach (Playlists playlist in userPlaylists)
                {
                    <div>
                        <img src="@playlist.PlaylistImage" height="50" width="50"/>
                    </div>
                }
            }

        </div>
    </div>
</div>

<!-- Modal for editing album -->
<div class="modal fade" id="CreatePlaylistModal" tabindex="-1" aria-labelledby="CreatePlaylistModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="CreatePlaylistModalLabel">Create Playlist</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <EditForm Model="@cPlaylistModel" FormName="CPlaylistForm" >
                    <div class="row">
                        <!--<input type="number" value />-->
                        <div class="col-7">
                            <InputFile @bind="cPlaylistModel.PlaylistImage" class="form-control" />
                        </div>
                        <div class="col-2 ms-3">
                            <input type="color" @bind="cPlaylistModel.PlaylistColor" />
                        </div>
                    </div>
                    <div class="pt-5">
                        <input maxlength="255" class="form-control" placeholder="Playlist Title" @bind="cPlaylistModel.PlaylistName"/>
                    </div> <br />
                    <label>current: PrivacyStatus</label> <br />
                    <select class="form-control" @bind="cPlaylistModel.MadePrivate">
                        <option selected>change privacy</option>
                        <option value="true">Private</option>
                        <option value="false">Public</option>
                    </select>
                    <div class="form-control invisible"> </div><br />
                    <div class="d-flex justify-content-end mb-3">
                        <input type="submit" class="btn btn-success border-success col-3" @onclick="@CreatePlaylist" value="Submit" data-bs-dismiss="modal"/>
                    </div>
                </EditForm>

            </div>


        </div>
    </div>
</div>

@code{
    [Inject]
    IHttpContextAccessor HttpContextAccessor { get; set; }
    [Inject]
    IMusic music { get; set; }
    public List<Playlists>? userPlaylists = new();
    public int? id { get; set; }

    public void GetId()
    {
        id = HttpContextAccessor.HttpContext.Session.GetInt32("Id");
    }
    public void AllPlaylists()
    {
        // userPlaylists =
        if (id != null)
        {
            userPlaylists = music.GetAllUserPlaylists((int)id);

        }
    }
    [SupplyParameterFromForm]
    private CPlaylistModel cPlaylistModel { get; set; } = new();

    protected void CreatePlaylist()
    {
        string imagePath = $"/ImagesAndSongs/Playlists/{Guid.NewGuid().ToString()}{Path.GetExtension(cPlaylistModel.PlaylistImage.FileName)}";
        string filePath = $"{Directory.GetCurrentDirectory()}/wwwroot{imagePath}";

        using var filestream = new FileStream(filePath, FileMode.Create);
        filestream.CopyTo(filestream);
        filestream.Close();

        music.CreatePlaylist((int)id, cPlaylistModel.PlaylistName, imagePath, cPlaylistModel.PlaylistColor, cPlaylistModel.MadePrivate);
    }
}
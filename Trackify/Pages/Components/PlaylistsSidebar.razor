@using Trackify.Domain.Models
@using Trackify.Service
@using Microsoft.AspNetCore.Http
@using FormData_Class
@inject NavigationManager Navigation

<head>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<!-- sidebar with playlists -->
@{
    GetId();
}

<div class="col-2 p-0" >
    <div class="card h-100" style="max-height: 696px;">
        <div class="d-flex justify-content-between m-0 p-2">
            <h3>Playlists</h3>
            <div class="p-0">
                @{
                    if (HttpContextAccessor.HttpContext.Session.GetInt32("LoggedIn") != null)
                    {
                        <div class="h1 fw-bold roundbutton pb-3 pt-2" type="button" @onclick="() => CreateBlankPlaylist()">+</div>
                    }
                }
            </div>
        </div>
        <div class="overflow-y-auto overflow-x-hidden">
            @{
                if (HttpContextAccessor.HttpContext.Session.GetInt32("LoggedIn") != null)
                {
                    if (AllPlaylists())
                    {
                        foreach (Playlists playlist in userPlaylists)
                        {
                            <div class="p-2 row" style="height: 66px;">
                                <img style="width: 74px;" src="@playlist.PlaylistImage" height="50" width="50" />
                                <div class="ps-1" style ="width: fit-content">
                                    <span class="p-0 fw-bold" id="clickable-link" @onclick="() => RedirectToPlaylist(playlist.PlaylistId)" style="width: fit-content">@playlist.PlaylistName</span>
                                    <br />
                                    <span style="width: fit-content">songs: @playlist.Songs.Count</span>
                                </div>
                            
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-5 h6 fw-semibold">Create a playlist to have it displayed here</div>
                    }
                }
                else
                {
                    <div class="p-5 h3 fw-semibold">Log in to create playlists</div>

                }
            }
            </div>
    </div>
</div>


@page
@using Trackify.Domain.Models
@model Trackify.Pages.Admin.ReviewApplicationsModel
@{
    List<Applications> allApplications = Model.allApplications;
}

<div class="d-flex justify-content-center">
    <div class="fw-bold h1">View Applications</div>
</div>
<div class="d-flex justify-content-end col-9">
    <div class="">
        <select>
            <option selected>Show All</option> <!--add little submit button to actually sort-->
            <option value="0">Show Pending</option>
            <option value="1">Show Accepted</option>
            <option value="2">Show Denied</option>
            <option value="3">Show Timed Out</option>
            <option value="4">Show Accepted by User</option>
        </select>
    </div>
</div>
<div class="d-flex justify-content-center">
    <div class="col-8 overflow-auto row gap-2 h-100">
        @{ 
            foreach (Applications application in allApplications)
            {
                <div class="card col-3 p-0">
                    <div class="card-header-pills account btn card p-0 m-0 col-5" asp-page="/User/Profile/@application.User.userId">@application.User.nickname</div>
                    <div class="p-3">
                        <span>Username: @@@application.User.username</span> <br />
                        <span>Account created: @application.User.accountAge</span> <br /><br />

                        <span>Date Applied: @application.ApplicationDate</span> <br />
                        <span>Current Status: </span> <span style="color: @Model.ChangeColorByStatus(application.Status);">@application.Status.ToString().Replace('_', ' ')</span>
                    </div>
                </div>
            }
        }

    </div>
</div>